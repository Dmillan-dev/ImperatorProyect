# Copy to .env and replace placeholders locally. Never commit .env.
IMPERATOR_IMAGE_TAG=REPLACE_WITH_FULL_GIT_SHA
IMPERATOR_HTTP_PORT=3000
IMPERATOR_JWT_ISSUER_URI=https://issuer.example.invalid
IMPERATOR_JWT_JWK_SET_URI=https://issuer.example.invalid/.well-known/jwks.json

# Optional compose.connectors.yaml values.
IMPERATOR_GITHUB_ORGANIZATION=REPLACE_WITH_FROZEN_ORGANIZATION
IMPERATOR_GITHUB_REPOSITORY=REPLACE_WITH_FROZEN_REPOSITORY
IMPERATOR_AWS_EXPECTED_ACCOUNT_ID=000000000000
IMPERATOR_AWS_REGION=REPLACE_WITH_FROZEN_REGION
IMPERATOR_AWS_PROFILE=default
