SECTION postgres-init
postgres (PostgreSQL) 18.6 (Debian 18.6-1.pgdg12+2)
9c440299ae04a0a79d55b8bf03307036d890a40979d2fb698073c9050d4b20a5  /usr/local/bin/docker-entrypoint.sh
39:	mkdir -p "$PGDATA"
41:	chmod 00700 "$PGDATA" || :
58:		find "$PGDATA" \! -user postgres -exec chown postgres '{}' +
63:# initialize empty PGDATA directory with new database via 'initdb'
80:				printf 'postgres:x:%s:%s:PostgreSQL:%s:/bin/false\n' "$uid" "$gid" "$PGDATA" > "$NSS_WRAPPER_PASSWD"
169:# usage: docker_process_init_files [file [file [...]]]
170:#    ie: docker_process_init_files /always-initdb.d/*
172:docker_process_init_files() {
192:			*.sql.gz)  printf '%s: running %s\n' "$0" "$f"; gunzip -c "$f" | docker_process_sql; printf '\n' ;;
193:			*.sql.xz)  printf '%s: running %s\n' "$0" "$f"; xzcat "$f" | docker_process_sql; printf '\n' ;;
194:			*.sql.zst) printf '%s: running %s\n' "$0" "$f"; zstd -dc "$f" | docker_process_sql; printf '\n' ;;
246:	if [ -s "$PGDATA/PG_VERSION" ]; then
248:	elif [ "$PGDATA" = "/var/lib/postgresql/$PG_MAJOR/docker" ]; then
266:# append POSTGRES_HOST_AUTH_METHOD to pg_hba.conf for "host" connections
284:		printf 'host all all all %s\n' "$POSTGRES_HOST_AUTH_METHOD"
285:	} >> "$PGDATA/pg_hba.conf"
303:	pg_ctl -D "$PGDATA" \
311:	pg_ctl -D "$PGDATA" -m fast -w stop
357:			# PGPASSWORD is required for psql when authentication is required for 'local' connections via pg_hba.conf and is otherwise harmless
363:			docker_process_init_files /docker-entrypoint-initdb.d/*

