{
  "name": "imperator-decision-review-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "predev": "next telemetry disable",
    "dev": "next dev",
    "prebuild": "next telemetry disable",
